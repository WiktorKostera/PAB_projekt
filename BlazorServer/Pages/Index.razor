@page "/"
@inject IAdminApiService Api
@inject ILogger<Index> Logger

<PageTitle>Pulpit – Admin Panel</PageTitle>

<RadzenText TextStyle="TextStyle.H4" Style="font-weight:700;margin-bottom:24px;">
    📊 Pulpit administratora
</RadzenText>

@if (_loading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:32px;">
        <div class="stat-card" style="border-left-color:#1976D2;">
            <div class="stat-number">@_eventCount</div>
            <div class="stat-label">🏁 Biegi łącznie</div>
        </div>
        <div class="stat-card" style="border-left-color:#43A047;">
            <div class="stat-number">@_activeEventCount</div>
            <div class="stat-label">✅ Aktywne biegi</div>
        </div>
        <div class="stat-card" style="border-left-color:#FB8C00;">
            <div class="stat-number">@_userCount</div>
            <div class="stat-label">👤 Uczestnicy</div>
        </div>
        <div class="stat-card" style="border-left-color:#8E24AA;">
            <div class="stat-number">@_upcomingCount</div>
            <div class="stat-label">📅 Nadchodzące biegi</div>
        </div>
    </div>

    <!-- Nearest events table -->
    <RadzenText TextStyle="TextStyle.H6" Style="margin-bottom:12px;">Najbliższe biegi</RadzenText>
    <RadzenDataGrid Data="@_upcomingEvents" TItem="EventDto"
                    AllowSorting="true" AllowPaging="true" PageSize="5"
                    Style="border-radius:8px;overflow:hidden;">
        <Columns>
            <RadzenDataGridColumn TItem="EventDto" Property="Name" Title="Nazwa biegu" />
            <RadzenDataGridColumn TItem="EventDto" Property="City" Title="Miasto" Width="140px" />
            <RadzenDataGridColumn TItem="EventDto" Property="EventDate" Title="Data" Width="140px" FormatString="{0:dd.MM.yyyy}" />
            <RadzenDataGridColumn TItem="EventDto" Property="MaxParticipants" Title="Maks. uczestników" Width="170px" />
            <RadzenDataGridColumn TItem="EventDto" Property="EntryFee" Title="Opłata" Width="110px" FormatString="{0:C}" />
            <RadzenDataGridColumn TItem="EventDto" Property="IsActive" Title="Aktywny" Width="100px">
                <Template Context="ev">
                    @if (ev.IsActive)
                    {
                        <RadzenBadge Text="Tak" BadgeStyle="BadgeStyle.Success" />
                    }
                    else
                    {
                        <RadzenBadge Text="Nie" BadgeStyle="BadgeStyle.Danger" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EventDto" Title="Akcje" Width="120px" Sortable="false">
                <Template Context="ev">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => Nav.NavigateTo($"/admin/events/edit/{ev.Id}"))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    [Inject] NavigationManager Nav { get; set; } = null!;

    private int _eventCount, _activeEventCount, _userCount, _upcomingCount;
    private List<EventDto> _upcomingEvents = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Ładowanie pulpitu administratora");
        var events = await Api.GetEventsAsync();
        var users = await Api.GetUsersAsync();

        _eventCount = events.Count;
        _activeEventCount = events.Count(e => e.IsActive);
        _userCount = users.Count;
        _upcomingEvents = events.Where(e => e.EventDate > DateTime.Now && e.IsActive)
                               .OrderBy(e => e.EventDate).Take(10).ToList();
        _upcomingCount = _upcomingEvents.Count;
        _loading = false;
    }
}
