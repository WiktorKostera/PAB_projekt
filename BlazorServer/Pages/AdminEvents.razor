@page "/admin/events"
@inject IAdminApiService Api
@inject DialogService DialogSvc
@inject NotificationService NotifySvc
@inject NavigationManager Nav
@inject ILogger<AdminEvents> Logger

<PageTitle>Zarządzanie biegami – Admin</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
    <RadzenText TextStyle="TextStyle.H4" Style="font-weight:700;">🏁 Zarządzanie biegami</RadzenText>
    <RadzenButton Text="+ Dodaj bieg" ButtonStyle="ButtonStyle.Primary" Icon="add_circle"
                  Click="OpenCreateDialog" />
</div>

<!-- Filtry -->
<RadzenCard Style="margin-bottom:16px;padding:16px;">
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end;">
        <RadzenTextBox @bind-Value="_searchText" Placeholder="Szukaj po nazwie..." Style="width:280px;"
                       Change="@((_) => FilterEvents())" />
        <RadzenDropDown @bind-Value="_cityFilter" Data="@_cities" Placeholder="Wszystkie miasta"
                        Style="width:200px;" Change="@((_) => FilterEvents())" AllowClear="true" />
        <RadzenCheckBox @bind-Value="_onlyActive" Change="@((bool _) => FilterEvents())" />
        <RadzenLabel Text="Tylko aktywne" Style="margin-left:-8px;" />
        <RadzenButton Text="Wyczyść" ButtonStyle="ButtonStyle.Light" Icon="clear"
                      Click="ClearFilters" />
    </div>
</RadzenCard>

@if (_loading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenDataGrid @ref="_grid" Data="@_filteredEvents" TItem="EventDto"
                    AllowSorting="true" AllowFiltering="false"
                    AllowPaging="true" PageSize="10"
                    Style="border-radius:8px;overflow:hidden;" RowSelect="OnRowSelect">
        <Columns>
            <RadzenDataGridColumn TItem="EventDto" Property="Id" Title="ID" Width="60px" />
            <RadzenDataGridColumn TItem="EventDto" Property="Name" Title="Nazwa biegu" />
            <RadzenDataGridColumn TItem="EventDto" Property="City" Title="Miasto" Width="130px" />
            <RadzenDataGridColumn TItem="EventDto" Property="EventDate" Title="Data biegu" Width="130px" FormatString="{0:dd.MM.yyyy}" />
            <RadzenDataGridColumn TItem="EventDto" Property="RegistrationDeadline" Title="Zap. do" Width="120px" FormatString="{0:dd.MM.yyyy}" />
            <RadzenDataGridColumn TItem="EventDto" Property="MaxParticipants" Title="Max" Width="80px" />
            <RadzenDataGridColumn TItem="EventDto" Property="EntryFee" Title="Opłata" Width="100px" FormatString="{0:C}" />
            <RadzenDataGridColumn TItem="EventDto" Property="IsActive" Title="Aktywny" Width="95px">
                <Template Context="ev">
                    @if (ev.IsActive)
                    {
                        <RadzenBadge Text="Tak" BadgeStyle="BadgeStyle.Success" />
                    }
                    else
                    {
                        <RadzenBadge Text="Nie" BadgeStyle="BadgeStyle.Danger" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EventDto" Title="Akcje" Width="140px" Sortable="false">
                <Template Context="ev">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                                  Click="@(() => OpenEditDialog(ev))" Style="margin-right:4px;" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Click="@(() => ConfirmDelete(ev))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <RadzenText TextStyle="TextStyle.Caption" Style="margin-top:8px;color:#888;">
        Wyświetlono @_filteredEvents.Count z @_allEvents.Count biegów
    </RadzenText>
}

<!-- Dialog tworzenia / edycji -->
@if (_showDialog)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:1000;display:flex;align-items:flex-start;justify-content:center;padding-top:48px;">
        <RadzenCard Style="min-width:520px;max-width:640px;padding:24px;">
            <RadzenText TextStyle="TextStyle.H6" Style="margin-bottom:16px;">
                @(_editingEvent == null ? "➕ Nowy bieg" : "✏️ Edytuj bieg")
            </RadzenText>

            <div>
                <div style="display:grid;gap:12px;">
                    <label style="display:grid;gap:4px;">
                        <span>Nazwa biegu *</span>
                        <input class="rz-inputtext" style="width:100%;" @bind="_form.Name" @bind:event="oninput" />
                    </label>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <label style="display:grid;gap:4px;">
                            <span>Miasto *</span>
                            <input class="rz-inputtext" style="width:100%;" @bind="_form.City" @bind:event="oninput" />
                        </label>
                        <label style="display:grid;gap:4px;">
                            <span>Lokalizacja *</span>
                            <input class="rz-inputtext" style="width:100%;" @bind="_form.Location" @bind:event="oninput" />
                        </label>
                    </div>

                    <label style="display:grid;gap:4px;">
                        <span>Opis *</span>
                        <textarea class="rz-inputtext" rows="3" style="width:100%;resize:vertical;" @bind="_form.Description" @bind:event="oninput"></textarea>
                    </label>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <label style="display:grid;gap:4px;">
                            <span>Data biegu *</span>
                            <input class="rz-inputtext" type="date" style="width:100%;" @bind="_form.EventDate" />
                        </label>
                        <label style="display:grid;gap:4px;">
                            <span>Zapisy do *</span>
                            <input class="rz-inputtext" type="date" style="width:100%;" @bind="_form.RegistrationDeadline" />
                        </label>
                    </div>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <label style="display:grid;gap:4px;">
                            <span>Maks. uczestników *</span>
                            <input class="rz-inputtext" type="number" min="1" step="1" style="width:100%;"
                                   value="@_form.MaxParticipants"
                                   @oninput="@(e => _form.MaxParticipants = ParseInt(e.Value, _form.MaxParticipants))" />
                        </label>
                        <label style="display:grid;gap:4px;">
                            <span>Opłata startowa (PLN) *</span>
                            <input class="rz-inputtext" type="number" min="0" step="0.01" style="width:100%;"
                                   value="@_form.EntryFee"
                                   @oninput="@(e => _form.EntryFee = ParseDecimal(e.Value, _form.EntryFee))" />
                        </label>
                    </div>

                    <label style="display:grid;gap:4px;">
                        <span>URL grafiki (opcjonalnie)</span>
                        <input class="rz-inputtext" style="width:100%;" @bind="_form.ImageUrl" @bind:event="oninput" />
                    </label>

                    @if (_editingEvent != null)
                    {
                        <div style="display:flex;align-items:center;gap:8px;">
                            <RadzenCheckBox @bind-Value="_form.IsActive" />
                            <RadzenLabel Text="Bieg aktywny" />
                        </div>
                    }
                </div>

                <div style="display:flex;gap:8px;margin-top:20px;justify-content:flex-end;">
                    <button type="button"
                            disabled="@_saving"
                            class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default"
                            @onclick="OnFormSubmit">
                        <span class="rz-button-box">
                            <span class="rz-button-icon-left rzi">save</span>
                            <span class="rz-button-text">@(_saving ? "Zapisywanie..." : "Zapisz")</span>
                        </span>
                    </button>
                    <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Light" Click="CloseDialog" />
                </div>
            </div>
        </RadzenCard>
    </div>
}

@code {
    private List<EventDto> _allEvents = new();
    private List<EventDto> _filteredEvents = new();
    private List<string> _cities = new();
    private bool _loading = true;
    private string _searchText = string.Empty;
    private string? _cityFilter;
    private bool _onlyActive;
    private bool _showDialog;
    private bool _saving;
    private EventDto? _editingEvent;
    private EventFormModel _form = new();
    private RadzenDataGrid<EventDto>? _grid;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Ładowanie listy biegów (admin)");
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        _loading = true;
        _allEvents = await Api.GetEventsAsync();
        _cities = _allEvents.Select(e => e.City).Distinct().OrderBy(c => c).ToList();
        FilterEvents();
        _loading = false;
    }

    private void FilterEvents()
    {
        _filteredEvents = _allEvents
            .Where(e =>
                (string.IsNullOrEmpty(_searchText) || e.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                && (_cityFilter == null || e.City == _cityFilter)
                && (!_onlyActive || e.IsActive))
            .OrderBy(e => e.EventDate)
            .ToList();
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _cityFilter = null;
        _onlyActive = false;
        FilterEvents();
    }

    private void OnRowSelect(EventDto ev) { }

    private void OpenCreateDialog()
    {
        _editingEvent = null;
        _form = new EventFormModel { EventDate = DateTime.Now.AddMonths(1), RegistrationDeadline = DateTime.Now.AddMonths(1).AddDays(-7) };
        _showDialog = true;
    }

    private void OpenEditDialog(EventDto ev)
    {
        _editingEvent = ev;
        _form = new EventFormModel
        {
            Name = ev.Name, Description = ev.Description, City = ev.City,
            Location = ev.Location, EventDate = ev.EventDate, RegistrationDeadline = ev.RegistrationDeadline,
            MaxParticipants = ev.MaxParticipants, EntryFee = ev.EntryFee, ImageUrl = ev.ImageUrl, IsActive = ev.IsActive
        };
        _showDialog = true;
    }

    private void CloseDialog() => _showDialog = false;

    private async Task OnFormSubmit()
    {
        if (_saving)
        {
            return;
        }

        if (!ValidateForm())
        {
            return;
        }

        _saving = true;

        try
        {
            if (_editingEvent == null)
            {
                var dto = new CreateEventDto
                {
                    Name = _form.Name!, Description = _form.Description ?? "", City = _form.City!, Location = _form.Location!,
                    EventDate = _form.EventDate, RegistrationDeadline = _form.RegistrationDeadline,
                    MaxParticipants = _form.MaxParticipants, EntryFee = _form.EntryFee, ImageUrl = _form.ImageUrl
                };
                await Api.CreateEventAsync(dto);
                Logger.LogInformation("Utworzono nowy bieg: {Name}", dto.Name);
                NotifySvc.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Bieg utworzony!", Duration = 3000 });
            }
            else
            {
                var dto = new UpdateEventDto
                {
                    Id = _editingEvent.Id, Name = _form.Name!, Description = _form.Description ?? "", City = _form.City!, Location = _form.Location!,
                    EventDate = _form.EventDate, RegistrationDeadline = _form.RegistrationDeadline,
                    MaxParticipants = _form.MaxParticipants, EntryFee = _form.EntryFee, ImageUrl = _form.ImageUrl, IsActive = _form.IsActive
                };
                await Api.UpdateEventAsync(_editingEvent.Id, dto);
                Logger.LogInformation("Zaktualizowano bieg ID={Id}", _editingEvent.Id);
                NotifySvc.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Bieg zaktualizowany!", Duration = 3000 });
            }

            _showDialog = false;
            await LoadEvents();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd zapisu biegu");
            NotifySvc.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Nie udało się zapisać biegu",
                Detail = ex.Message,
                Duration = 6000
            });
        }
        finally
        {
            _saving = false;
        }
    }

    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)
            || string.IsNullOrWhiteSpace(_form.City)
            || string.IsNullOrWhiteSpace(_form.Location)
            || string.IsNullOrWhiteSpace(_form.Description))
        {
            NotifySvc.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Wypełnij nazwę, miasto, lokalizację i opis", Duration = 4000 });
            return false;
        }

        if (_form.EventDate <= DateTime.Now)
        {
            NotifySvc.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Data biegu musi być w przyszłości", Duration = 4000 });
            return false;
        }

        if (_form.RegistrationDeadline >= _form.EventDate)
        {
            NotifySvc.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Termin zapisów musi być przed datą biegu", Duration = 4000 });
            return false;
        }

        if (_form.MaxParticipants <= 0)
        {
            NotifySvc.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Maksymalna liczba uczestników musi być większa od zera", Duration = 4000 });
            return false;
        }

        if (_form.EntryFee < 0)
        {
            NotifySvc.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Opłata nie może być ujemna", Duration = 4000 });
            return false;
        }

        return true;
    }

    private static int ParseInt(object? value, int fallback) =>
        int.TryParse(Convert.ToString(value), out var result) ? result : fallback;

    private static decimal ParseDecimal(object? value, decimal fallback)
    {
        var text = Convert.ToString(value);
        return decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var result)
            || decimal.TryParse(text, out result)
                ? result
                : fallback;
    }

    private async Task ConfirmDelete(EventDto ev)
    {
        var confirmed = await DialogSvc.Confirm(
            $"Usunac bieg \"{ev.Name}\"? Tej operacji nie mozna cofnac.",
            "Potwierdzenie usunięcia",
            new ConfirmOptions { OkButtonText = "Usuń", CancelButtonText = "Anuluj" });

        if (confirmed != true) return;

        await Api.DeleteEventAsync(ev.Id);
        Logger.LogWarning("Usunięto bieg ID={Id} Name={Name}", ev.Id, ev.Name);
        NotifySvc.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Bieg usunięty", Duration = 3000 });
        await LoadEvents();
    }

    private class EventFormModel
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? City { get; set; }
        public string? Location { get; set; }
        public DateTime EventDate { get; set; } = DateTime.Now.AddMonths(1);
        public DateTime RegistrationDeadline { get; set; } = DateTime.Now.AddMonths(1).AddDays(-7);
        public int MaxParticipants { get; set; } = 100;
        public decimal EntryFee { get; set; } = 50;
        public string? ImageUrl { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
