<Window x:Class="RunningEventsSystem.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Zapisów na Biegi" Height="700" Width="1050"
        Background="#0D0D0D" WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Styl przycisku głównego -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E7D32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#145214"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl przycisku danger -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="#7B1010"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl przycisku success -->
        <Style x:Key="BtnSuccess" TargetType="Button">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="CaretBrush" Value="#4CAF50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#1A1A1A" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="#1A1A1A" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl ComboBox z własnym templatem -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border Background="#1A1A1A" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#4CAF50" Data="M0,0 L4,4 L8,0 Z"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplate="{TemplateBinding ItemTemplate}"
                                              Margin="10,6,25,6"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="#E0E0E0"/> 
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="True"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Background="#1A1A1A" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="0,0,5,5">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2E7D32"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1B5E20"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Styl DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E1E1E"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="AlternatingRowBackground" Value="#161616"/>
            <Setter Property="RowBackground" Value="#111111"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Styl nagłówka DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="#CCFFCC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>

        <!-- Styl wiersza DataGrid -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2E1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Styl komórki DataGrid -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Styl TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#1A1A1A"
                                CornerRadius="6,6,0,0" Margin="2,0" Padding="{TemplateBinding Padding}"
                                BorderBrush="#2E7D32" BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1B5E20"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1A2E1A"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- NAGŁÓWEK -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#000000" Offset="0"/>
                    <GradientStop Color="#0A1A0A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏃" FontSize="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="System Zapisów na Biegi" FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Zarządzaj eventami, uczestnikami i wynikami"
                                   FontSize="12" Foreground="#4CAF50"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush x:Name="StatusDotColor" Color="Gray"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="TxtConnectionStatus" Text="Łączenie..."
                               Foreground="#4CAF50" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ZAKŁADKI -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,8,10,8">

            <!-- ═══ EVENTY ═══ -->
            <TabItem Header="📅  Eventy">
                <Border Background="#111111" CornerRadius="0,8,8,8" Padding="15"
                        BorderBrush="#2E7D32" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Lista dostępnych biegów" FontSize="16" FontWeight="Bold"
                                       Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Button Content="🔄  Odśwież" Style="{StaticResource BtnPrimary}"
                                    x:Name="BtnRefreshEvents" Click="BtnRefreshEvents_Click"/>
                            <TextBlock x:Name="TxtEventStatus" Foreground="#555555" FontStyle="Italic"
                                       VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12"/>
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="8" BorderBrush="#2E7D32" BorderThickness="1">
                            <DataGrid x:Name="EventsGrid" SelectionChanged="EventsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Nazwa eventu" Binding="{Binding Name}" Width="220"/>
                                    <DataGridTextColumn Header="Miasto" Binding="{Binding City}" Width="120"/>
                                    <DataGridTextColumn Header="Data biegu" Binding="{Binding EventDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                                    <DataGridTextColumn Header="Deadline zapisu" Binding="{Binding RegistrationDeadline, StringFormat=dd.MM.yyyy}" Width="120"/>
                                    <DataGridTextColumn Header="Maks. uczestników" Binding="{Binding MaxParticipants}" Width="140"/>
                                    <DataGridTextColumn Header="Wpisowe" Binding="{Binding EntryFee, StringFormat={}{0} zł}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ═══ ZAPISZ SIĘ ═══ -->
            <TabItem Header="✍️  Zapisz się">
                <Border Background="#111111" CornerRadius="0,8,8,8" Padding="20"
                        BorderBrush="#2E7D32" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Formularz zapisu" FontSize="16" FontWeight="Bold"
                                       Foreground="#4CAF50" Margin="0,0,0,20"/>

                            <TextBlock Text="Wybierz event:" FontWeight="SemiBold"
                                       Margin="0,0,0,5" Foreground="#AAAAAA"/>
                            <ComboBox x:Name="CmbEvents" Margin="0,0,0,15">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Wybierz uczestnika:" FontWeight="SemiBold"
                                       Margin="0,0,0,5" Foreground="#AAAAAA"/>
                            <ComboBox x:Name="CmbUsers" Margin="0,0,0,20">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="✅  Zapisz na bieg" Style="{StaticResource BtnSuccess}"
                                    Click="BtnRegister_Click" HorizontalAlignment="Stretch"/>

                            <Border Margin="0,15,0,0" Padding="12" CornerRadius="6"
                                    x:Name="RegStatusBorder" Visibility="Collapsed" BorderThickness="1">
                                <TextBlock x:Name="TxtRegStatus" FontWeight="SemiBold"
                                           TextWrapping="Wrap" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Fill="#2E7D32" Margin="0,30"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Zapisani na wybrany event" FontSize="16" FontWeight="Bold"
                                           Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Button Content="📋  Pokaż" Style="{StaticResource BtnPrimary}"
                                        Click="BtnShowRegistrations_Click"/>
                            </StackPanel>

                            <Border Grid.Row="1" CornerRadius="8" BorderBrush="#2E7D32" BorderThickness="1">
                                <DataGrid x:Name="RegistrationsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Uczestnik" Binding="{Binding UserFullName}" Width="180"/>
                                        <DataGridTextColumn Header="Data zapisu" Binding="{Binding RegistrationDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                        <DataGridTemplateColumn Header="Akcja" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Anuluj" Style="{StaticResource BtnDanger}"
                                                            Tag="{Binding Id}" Click="BtnCancelReg_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ═══ UCZESTNICY ═══ -->
            <TabItem Header="👤  Uczestnicy">
                <Border Background="#111111" CornerRadius="0,8,8,8" Padding="20"
                        BorderBrush="#2E7D32" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Lista uczestników" FontSize="16" FontWeight="Bold"
                                       Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Button Content="🔄  Odśwież" Style="{StaticResource BtnPrimary}"
                                    Click="BtnRefreshUsers_Click"/>
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="8" BorderBrush="#2E7D32"
                                BorderThickness="1" Margin="0,0,0,15">
                            <DataGrid x:Name="UsersGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="Imię" Binding="{Binding FirstName}" Width="160"/>
                                    <DataGridTextColumn Header="Nazwisko" Binding="{Binding LastName}" Width="160"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Row="2" Background="#0D0D0D" BorderBrush="#2E7D32"
                                BorderThickness="1" Padding="15" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="➕  Dodaj nowego uczestnika" FontWeight="Bold"
                                           Foreground="#4CAF50" Margin="0,0,0,12" FontSize="14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Imię" FontSize="11" Foreground="#555555" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtFirstName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nazwisko" FontSize="11" Foreground="#555555" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtLastName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Email" FontSize="11" Foreground="#555555" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtEmail"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Hasło" FontSize="11" Foreground="#555555" Margin="0,0,0,3"/>
                                        <PasswordBox x:Name="TxtPassword"/>
                                    </StackPanel>
                                    <Button Grid.Column="8" Content="Dodaj" Style="{StaticResource BtnSuccess}"
                                            VerticalAlignment="Bottom" Click="BtnAddUser_Click"/>
                                </Grid>
                                <TextBlock x:Name="TxtUserStatus" Margin="0,10,0,0"
                                           FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ═══ WYNIKI ═══ -->
            <TabItem Header="🏆  Wyniki">
                <Border Background="#111111" CornerRadius="0,8,8,8" Padding="20"
                        BorderBrush="#2E7D32" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Wybierz event:" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AAAAAA"/>
                            <ComboBox x:Name="CmbResultsEvent" Width="220" Margin="0,0,12,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="📊  Pokaż wyniki" Style="{StaticResource BtnPrimary}"
                                    Click="BtnShowResults_Click"/>
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="8" BorderBrush="#2E7D32" BorderThickness="1">
                            <DataGrid x:Name="ResultsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="🥇 Miejsce" Binding="{Binding Place}" Width="100"/>
                                    <DataGridTextColumn Header="Uczestnik" Binding="{Binding UserFullName}" Width="220"/>
                                    <DataGridTextColumn Header="Czas ukończenia" Binding="{Binding FinishTime}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#000000" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar" Text="Gotowy" Foreground="#4CAF50"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="System Zapisów na Biegi v1.0"
                           Foreground="#333333" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
